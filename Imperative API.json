	"item": [
		{
			"name": "Create_User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Перевірка статусу відповіді\r",
							"pm.test(\"Status code is 201 Created\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"// Збереження ID створеного користувача у змінну середовища\r",
							"const responseData = pm.response.json();\r",
							"pm.environment.set(\"tempUserId\", responseData.id); \r",
							"console.log(\"Created User ID (temp):\", pm.environment.get(\"tempUserId\"));"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"name\": \"Ivan kovalenko\",\r\n    \"username\": \"ivanko\",\r\n    \"email\": \"ivan.ko@example.com\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get User Details",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"console.log(\"Value of existingUserId before Get User Details:\", pm.environment.get(\"existingUserId\"));\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"User name is Leanne Graham (for ID 1)\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    // Перевіряємо ім'я для користувача з ID 1\r",
							"    pm.expect(responseData.name).to.eql(\"Leanne Graham\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users/{{existingUserId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"{{existingUserId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Update User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"User name is updated to Oleg Boyko\", function () {\r",
							"    const responseData = pm.response.json();\r",
							"    pm.expect(responseData.name).to.eql(\"Oleg Boyko\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"id\": {{existingUserId}},\r\n    \"name\": \"Oleg Boyko\",\r\n    \"username\": \"oleg\",\r\n    \"email\": \"oleg.boyko@example.com\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/users/{{existingUserId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"{{existingUserId}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Delete User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"// JSONPlaceholder повертає порожній об'єкт при видаленні\r",
							"// тому перевіряємо, що відповідь не містить даних або має певний формат\r",
							"pm.test(\"Response is empty or expected format\", function () {\r",
							"    pm.expect(pm.response.json()).to.be.empty; \r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/users/{{existingUserId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"users",
						"{{existingUserId}}"
					]
				}
			},
			"response": []
		}
	]
